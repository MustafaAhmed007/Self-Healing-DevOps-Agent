# GitHub
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
DEFAULT_BRANCH=main

# Execution
SANDBOX_BACKEND=local
SANDBOX_IMAGE=python:3.12-slim
AUTO_PUBLISH_PR=false
APPROVAL_REQUIRED_FOR_HIGH_RISK=true

# LLM
LLM_MODEL=ollama/llama3.2
LLM_API_KEY=

# Persistence / queue
DATABASE_URL=postgresql://shda:local-only@localhost:5432/shda
REDIS_URL=redis://localhost:6379/0

# Evidence / telemetry
EVIDENCE_DIR=./data/evidence
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
